	<h3 class="mt-8">{item.title}</h3>
	<p>{item.blurb}</p>
	<PreviewTabs codes={[{ id: "react", label: "React", code: item.code, lang: "tsx" }]}>
		<Preview variant={item.variant} />
	</PreviewTabs>
{/each}

